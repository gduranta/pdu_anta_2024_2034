# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR GEOVISOR PDU ANTA (2024 - 2034)
# Municipalidad Provincial de Anta - Gerencia de Desarrollo Urbano y Rural (GDUR)
#
# Plantilla de Configuración Corporativa de Base de Datos y Seguridad
# Copiar este archivo como .Renviron en el servidor de producción:
#   cp .Renviron.example .Renviron
# ==============================================================================

# Fuente de datos espaciales (local | postgres | supabase)
PDU_DATA_SOURCE=local

# ------------------------------------------------------------------------------
# PARÁMETROS CORPORATIVOS DE BASE DE DATOS POSTGRESQL / POSTGIS (OPCIÓN 2 OTI)
# Resuelve condiciones de carrera (CWE-362) y provee concurrencia ACID
# ------------------------------------------------------------------------------
# Modo de almacenamiento de sesiones (auto | postgres | local)
# Si es 'auto', se activará PostgreSQL en cuanto se definan las credenciales
PDU_DB_BACKEND=local

# Credenciales de conexión directa al servidor PostgreSQL municipal
# Complete estos campos solo si PDU_DB_BACKEND=postgres.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=geovisor_anta_pdu
PGUSER=pdu_app_user
PGPASSWORD=
PGSSLMODE=require

# Alternativa: Conexión mediante URI unificada (ej. Supabase o servicio Cloud)
# DATABASE_URL=postgresql://pdu_app_user:SECRETO@localhost:5432/geovisor_anta_pdu?sslmode=require

# Secreto criptográfico para hashing de DNI (configurar solo fuera de Git)
# Si se deja vacío, se genera una clave local persistente en outputs/.pdu_secret_key.
# PDU_PEPPER_KEY=GENERAR_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

